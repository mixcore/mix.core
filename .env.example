# Mixcore CMS Environment Configuration
# Copy this file to .env and update the values for your environment
# IMPORTANT: Never commit .env files with real credentials to version control

# =============================================================================
# ASP.NET Core Configuration
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
# Options: Development, Staging, Production

ASPNETCORE_URLS=http://+:80;https://+:443
# The URLs that the application listens on

# =============================================================================
# Database Configuration
# =============================================================================
# MySQL (Default)
DB_PROVIDER=MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mixcore
DB_USER=mixcore
DB_PASSWORD=your_secure_password_here

# Full connection string (alternative to individual settings)
# ConnectionStrings__MixDbContext=Server=localhost;Database=mixcore;User=mixcore;Password=your_password;

# SQL Server (Alternative)
# DB_PROVIDER=SqlServer
# ConnectionStrings__MixDbContext=Server=localhost;Database=mixcore;User Id=sa;Password=your_password;TrustServerCertificate=True;

# PostgreSQL (Alternative)
# DB_PROVIDER=PostgreSQL
# ConnectionStrings__MixDbContext=Host=localhost;Database=mixcore;Username=mixcore;Password=your_password;

# SQLite (Alternative - for development only)
# DB_PROVIDER=SQLite
# ConnectionStrings__MixDbContext=Data Source=mixcore.db

# =============================================================================
# Redis Cache Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis__ConnectionString=localhost:6379,password=your_redis_password

# =============================================================================
# Authentication & Security
# =============================================================================
# JWT Configuration
JWT_SECRET_KEY=your_super_secret_key_at_least_32_characters_long
JWT_ISSUER=mixcore
JWT_AUDIENCE=mixcore-api
JWT_EXPIRY_MINUTES=60

# OAuth 2.0 / OpenID Connect (Optional)
# OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
# OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
# OAUTH_FACEBOOK_APP_ID=your_facebook_app_id
# OAUTH_FACEBOOK_APP_SECRET=your_facebook_app_secret

# =============================================================================
# Storage Configuration
# =============================================================================
# Local Storage (Default)
STORAGE_PROVIDER=Local
STORAGE_PATH=./wwwroot/mixcontent

# Azure Blob Storage (Alternative)
# STORAGE_PROVIDER=AzureBlob
# AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
# AZURE_STORAGE_CONTAINER=mixcore

# AWS S3 (Alternative)
# STORAGE_PROVIDER=S3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=mixcore

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Mixcore CMS
SMTP_ENABLE_SSL=true

# =============================================================================
# Logging & Monitoring
# =============================================================================
LOGGING_LEVEL=Information
# Options: Trace, Debug, Information, Warning, Error, Critical

# Application Insights (Optional)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your_app_insights_connection_string

# Serilog Seq (Optional)
# SEQ_SERVER_URL=http://localhost:5341
# SEQ_API_KEY=your_seq_api_key

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_SWAGGER=true
ENABLE_GRAPHQL=true
ENABLE_SIGNALR=true
ENABLE_GRPC=false

# =============================================================================
# Multi-Tenancy (Optional)
# =============================================================================
# TENANCY_ENABLED=false
# TENANCY_STRATEGY=Host
# Options: Host, Path, Header

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
# Comma-separated list of allowed origins

# =============================================================================
# HTTPS/SSL Configuration (for Kestrel)
# =============================================================================
# ASPNETCORE_Kestrel__Certificates__Default__Path=/path/to/cert.pfx
# ASPNETCORE_Kestrel__Certificates__Default__Password=cert_password
