                    return guidId;
                }
                else
                {
                    if (int.TryParse(ParentId, out var intId))
                    {
                        return intId;
                    }
                }
                return null;
            }
            catch (Exception ex)
            {
                throw new MixException(MixErrorStatus.Badrequest, ex);
            }
        }
        #endregion
    }
