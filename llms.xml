                    {
                        MixDbHelper.ParseRawDataToEntityAsync(item, _mixDb.Columns);
                        await LoadRelationShips(item, null, _mixDb, cancellationToken);
                    }
                }
                return data;
            }
            throw new TaskCanceledException();
        }
