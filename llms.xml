    <!-- end master styles -->
    @Html.Raw(Model.Template?.Styles)
}
@section Scripts{
    <!-- master scripts -->
    @Html.Raw(Model.Layout?.Scripts)
    <!-- end master scripts -->
    @Html.Raw(Model.Template?.Scripts)
}
