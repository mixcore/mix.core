            {
                return BadRequest($"Cannot create {nameof(TView)} instance.");
            }

            result.InitDefaultValues(Culture?.Specificulture, Culture?.Id);
            await result.ExpandView();
            return Ok(result);
        }

        #endregion Routes


    }
}
