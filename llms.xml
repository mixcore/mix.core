                }
                else
                {
                    if (top.HasValue)
                    {
                        lstModel = await sortedQuery.Skip(skip ?? 0)
                            .SelectMembers(members)
                    .Take(top.Value)
                    .ToListAsync().ConfigureAwait(false);
                    }
                    else
                    {
