<Project>
  <PropertyGroup>
    <!-- Language Version (can be overridden by individual projects) -->
    <LangVersion>latest</LangVersion>

    <!-- Build Settings -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Assembly Information -->
    <Company>Mixcore Foundation</Company>
    <Product>Mixcore CMS</Product>
    <Copyright>Copyright (c) Mixcore Foundation. All rights reserved.</Copyright>

    <!-- Package Information (for NuGet packages) -->
    <Authors>Mixcore Foundation</Authors>
    <Description>Enterprise-grade .NET CMS and API platform with modular monolith architecture</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://mixcore.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mixcore/mix.core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cms;api;dotnet;aspnetcore;mixcore;headless-cms;enterprise</PackageTags>

    <!-- Deterministic Builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Suppress common warnings -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
</Project>
